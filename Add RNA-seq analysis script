#!/usr/bin/env bash
# WSL Ubuntu에서 rnaseq-var 환경을 활성화한 뒤 bash run_rnaseq_variant.sh 실행
# 기본 입력 경로는 기존 HCC1395 실습 폴더를 기준으로 한다.
set -euo pipefail

if [[ $# -ne 0 && $# -ne 5 ]]; then
  echo "Usage: bash run_rnaseq_variant.sh [R1.fastq.gz R2.fastq.gz chr22.fa ncbiRefSeq.txt.gz NEW_OUTPUT_DIR]" >&2
  exit 2
fi
if [[ $# -eq 0 ]]; then
  set -- raw/hcc1395_tumor_rep1_r1.fastq.gz raw/hcc1395_tumor_rep1_r2.fastq.gz \
    ref/chr22.fa annotation/hg38.ncbiRefSeq.txt.gz auto_hcc1395
fi
r1=$1
r2=$2
reference=$3
refseq=$4
out=$5

for tool in fastqc fastp hisat2 hisat2-build samtools bcftools python3; do
  command -v "$tool" >/dev/null || { echo "Missing command: $tool" >&2; exit 1; }
done
for input in "$r1" "$r2" "$reference" "$refseq"; do
  [[ -r "$input" && -s "$input" ]] || { echo "Missing or empty input: $input" >&2; exit 1; }
done
if [[ -e "$out" || -L "$out" ]]; then
  echo "Output already exists: $out. Choose a new output directory." >&2
  exit 1
fi
mkdir -- "$out"
trap 'echo "Run stopped at line $LINENO. See the output directory and alignment log." >&2' ERR
mkdir -p "$out/qc/raw" "$out/qc/trimmed" "$out/trimmed" "$out/ref" "$out/align" "$out/variants" "$out/annotation"

echo "[1/5] FASTQ quality checks and adapter trimming"
fastqc --threads 2 --outdir "$out/qc/raw" "$r1" "$r2"
trim1="$out/trimmed/r1.trimmed.fastq.gz"
trim2="$out/trimmed/r2.trimmed.fastq.gz"
fastp --in1 "$r1" --in2 "$r2" --out1 "$trim1" --out2 "$trim2" \
  --detect_adapter_for_pe --disable_quality_filtering --disable_trim_poly_g \
  --length_required 30 --thread 4 \
  --html "$out/qc/trimmed/fastp.html" --json "$out/qc/trimmed/fastp.json"
fastqc --threads 2 --outdir "$out/qc/trimmed" "$trim1" "$trim2"

echo "[2/5] Build the chr22 index and align paired reads"
# FASTA를 복사해 기존 참조 폴더의 인덱스를 수정하지 않는다.
fasta="$out/ref/chr22.fa"
cp -- "$reference" "$fasta"
samtools faidx "$fasta"
index="$out/ref/chr22"
hisat2-build -p 4 "$fasta" "$index" > "$out/ref/hisat2-build.log" 2>&1
bam="$out/align/reads.sorted.bam"
alignment_log="$out/align/hisat2.log"
hisat2 -p 4 -x "$index" -1 "$trim1" -2 "$trim2" \
  --rg-id HCC1395_tumor_rep1 --rg SM:HCC1395_tumor_rep1 \
  2> "$alignment_log" | samtools sort -@ 4 -o "$bam" -
samtools quickcheck -v "$bam"
samtools index "$bam"

echo "[3/5] Call and filter SNV candidates"
raw_vcf="$out/variants/raw.vcf.gz"
filtered_vcf="$out/variants/filtered.vcf.gz"
bcftools mpileup -Ou -f "$fasta" -r chr22 \
  -q 20 -Q 20 -I -a FORMAT/DP,FORMAT/AD "$bam" |
  bcftools call -mv -Oz -o "$raw_vcf"
bcftools view -m2 -M2 -v snps \
  -i 'QUAL>=30 && FMT/DP>=10 && FMT/AD[0:1]>=3' \
  -Oz -o "$filtered_vcf" "$raw_vcf"
bcftools index "$filtered_vcf"

echo "[4/5] Annotate RefSeq overlap and predict coding effects"
bcftools query -f '%CHROM\t%POS0\t%POS\t%REF\t%ALT[\t%DP\t%AD]\n' \
  "$filtered_vcf" > "$out/annotation/candidates.bed"

python3 - "$fasta" "$refseq" "$out/annotation" <<'PY'
import csv
import gzip
import sys
from itertools import product
from pathlib import Path

fasta, refseq, annotation_dir = map(Path, sys.argv[1:])
with fasta.open() as handle:
    if handle.readline().split()[0] != ">chr22":
        raise ValueError("Expected a chr22 reference named >chr22.")
    genome = "".join(line.strip() for line in handle).upper()

transcripts = []
with gzip.open(refseq, "rt") as handle:
    for line in handle:
        f = line.rstrip("\n").split("\t")
        if f[2] != "chr22":
            continue
        tx_start, tx_end, cds_start, cds_end = map(int, f[4:8])
        starts = map(int, f[9].rstrip(",").split(","))
        ends = map(int, f[10].rstrip(",").split(","))
        exons = list(zip(starts, ends))
        transcripts.append((f[12], f[1], f[3], tx_start, tx_end, cds_start, cds_end,
                            exons, f[13:15] == ["cmpl", "cmpl"]))
if not transcripts:
    raise ValueError("No chr22 transcripts found in the UCSC ncbiRefSeq table.")

codons = ("".join(bases) for bases in product("TCAG", repeat=3))
amino_acid = dict(zip(
    codons, "FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG"
))
complement = str.maketrans("ACGT", "TGCA")


def codon_effect(base, alt, strand, exons, cds_start, cds_end):
    """Join CDS blocks in transcript order and change one base in its codon."""
    blocks = [(max(left, cds_start), min(right, cds_end)) for left, right in exons
              if max(left, cds_start) < min(right, cds_end)]
    if strand == "-":
        blocks.reverse()
    parts = [genome[left:right] for left, right in blocks]
    if strand == "-":
        parts = [part.translate(complement)[::-1] for part in parts]
    cds = "".join(parts)
    if not cds or len(cds) % 3:
        return None

    offset = 0
    for left, right in blocks:
        if left <= base < right:
            offset += base - left if strand == "+" else right - 1 - base
            break
        offset += right - left
    else:
        return None

    index, slot = divmod(offset, 3)
    ref_codon = cds[index * 3:index * 3 + 3]
    alt_base = alt if strand == "+" else alt.translate(complement)
    alt_codon = ref_codon[:slot] + alt_base + ref_codon[slot + 1:]
    if ref_codon not in amino_acid or alt_codon not in amino_acid:
        return None

    ref_aa, alt_aa = amino_acid[ref_codon], amino_acid[alt_codon]
    if ref_aa == alt_aa:
        effect = "synonymous"
    elif index == 0 and ref_codon == "ATG":
        effect = "start_lost_candidate"
    elif alt_aa == "*":
        effect = "stop_gained"
    elif ref_aa == "*":
        effect = "stop_lost"
    else:
        effect = "missense"
    return index + 1, ref_codon, alt_codon, ref_aa, alt_aa, effect


with (annotation_dir / "candidates.bed").open() as candidates, \
     (annotation_dir / "refseq_overlap.tsv").open("w") as overlap, \
     (annotation_dir / "refseq_regions.tsv").open("w") as regions, \
     (annotation_dir / "refseq_codon_effects.tsv").open("w") as effects:
    overlap_table, region_table, effect_table = [
        csv.writer(handle, delimiter="\t", lineterminator="\n")
        for handle in (overlap, regions, effects)
    ]
    core = ("CHROM", "POS", "REF", "ALT", "DP", "AD")
    overlap_table.writerow((*core, "GENE"))
    region_table.writerow((*core, "GENE", "TRANSCRIPT", "REGION"))
    effect_table.writerow((*core[:4], "GENE", "TRANSCRIPT", "CODON_NUM",
                           "REF_CODON", "ALT_CODON", "REF_AA", "ALT_AA", "EFFECT"))

    for line in candidates:
        chrom, start, pos, ref, alt, dp, ad = line.rstrip("\n").split("\t")
        base = int(start)
        variant = (chrom, pos, ref, alt, dp, ad)
        if chrom != "chr22" or not 0 <= base < len(genome) or genome[base] != ref:
            raise ValueError(f"VCF REF does not match FASTA at {chrom}:{pos}.")
        genes = {}
        for gene, tx, strand, tx_start, tx_end, cds_start, cds_end, exons, complete in transcripts:
            if not tx_start <= base < tx_end:
                continue
            genes[gene] = None
            if not any(left <= base < right for left, right in exons):
                region = "intronic"
            elif cds_start <= base < cds_end:
                region = "coding_exon"
            else:
                region = "noncoding_exon"
            region_table.writerow((*variant, gene, tx, region))
            if region == "coding_exon" and complete and tx.startswith("NM_") and alt in {"A", "C", "G", "T"}:
                effect = codon_effect(base, alt, strand, exons, cds_start, cds_end)
                if effect:
                    effect_table.writerow((*variant[:4], gene, tx, *effect))
        if not genes:
            region_table.writerow((*variant, ".", ".", "no_transcript_overlap"))
        for gene in genes or (".",):
            overlap_table.writerow((*variant, gene))
PY

echo "[5/5] Write the reproducibility summary"
{
  grep 'overall alignment rate' "$alignment_log"
  printf 'raw_vcf_records\t'
  bcftools view -H "$raw_vcf" | wc -l
  printf 'filtered_vcf_records\t'
  bcftools view -H "$filtered_vcf" | wc -l
  awk -F '\t' '
    NR > 1 {
      effects[$12]++
      variant = $1 FS $2 FS $3 FS $4
      if (!seen[variant]++) unique++
      rows++
    }
    END {
      printf "variant_transcript_rows\t%d\nunique_coding_snvs\t%d\n", rows, unique
      for (effect in effects) print effect "\t" effects[effect]
    }
  ' "$out/annotation/refseq_codon_effects.tsv"
} | tee "$out/summary.tsv"
